# ---------------------------------------------------------------------------
# App (Vercel project env vars)
# ---------------------------------------------------------------------------

# Tenant used when the hostname is localhost or a *.vercel.app preview URL.
DEFAULT_TENANT_SLUG=rushmart
# Local previews behind a tunnel only: any unknown host uses DEFAULT_TENANT_SLUG. Ignored on Vercel production.
TENANT_FALLBACK_ALL_HOSTS=false

# Cloudflare Turnstile site key (public). The secret goes in Supabase: Auth > Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase. Local values come from `npm run db:start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Scripts only (seed). Never expose to the browser; not needed on Vercel.
# ---------------------------------------------------------------------------

# Optional locally: scripts fall back to `supabase status`. Required for a hosted project.
SUPABASE_SECRET_KEY=

# Logins created by `npm run db:seed`. Local defaults exist; required (12+ char passwords) for hosted.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=

# ---------------------------------------------------------------------------
# Local preview through a tunnel (optional; never on Vercel)
# ---------------------------------------------------------------------------
# Browser reaches Supabase via this app at /sb, forwarded to SUPABASE_PROXY_TARGET.
# NEXT_PUBLIC_SUPABASE_BROWSER_URL=/sb
# SUPABASE_PROXY_TARGET=http://127.0.0.1:54321
