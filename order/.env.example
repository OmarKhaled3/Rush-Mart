# ---------------------------------------------------------------------------
# App (Vercel project env vars)
# ---------------------------------------------------------------------------

# Tenant used when the hostname is localhost or a *.vercel.app preview URL.
DEFAULT_TENANT_SLUG=rushmart

# Supabase. Local values come from `npm run db:start` (or `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Scripts only (seed). Never expose to the browser; not needed on Vercel.
# ---------------------------------------------------------------------------

# Optional locally: scripts fall back to `supabase status`. Required for a hosted project.
SUPABASE_SECRET_KEY=

# Logins created by `npm run db:seed`. Local defaults exist; required (12+ char passwords) for hosted.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
